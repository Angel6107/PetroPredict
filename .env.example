# Copia este archivo como .env para personalizar la configuración.
# Por defecto la API usa SQLite local; para PostgreSQL usa:
# DATABASE_URL=postgresql+psycopg://petro:petro@localhost:5432/petropredict
DATABASE_URL=sqlite:///./petropredict.db
ANOMALY_THRESHOLD=0.6
VIBRATION_LIMIT=7.1
TEMPERATURE_LIMIT=85.0
